---
import { buttonVariants } from '@components/ui/button'
import Layout from '@layouts/Layout.astro'
---

<Layout title="404 — Page Not Found" noIndex={true}>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,var(--line)_1.5px,transparent_1.5px)] bg-size-[28px_28px] opacity-70"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_70%_at_50%_50%,transparent_30%,var(--page-base)_100%)]"
    >
    </div>

    <div class="animate-slide-up relative z-10 flex flex-col items-center text-center">
      <div class="relative mb-6 leading-none select-none">
        <span
          aria-hidden="true"
          class="font-display text-ink/6 absolute top-3 left-3 text-[9rem] font-extrabold tracking-tighter md:text-[15rem]"
        >
          404
        </span>
        <span
          class="font-display text-ink relative text-[9rem] font-extrabold tracking-tighter md:text-[15rem]"
        >
          404
        </span>
      </div>

      <div class="bg-line h-px w-16"></div>

      <h1 class="font-display text-ink mt-8 text-2xl font-bold tracking-tight md:text-3xl">
        Page not found
      </h1>
      <p class="text-dim mt-3 max-w-xs text-base leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class={buttonVariants({ variant: 'accent', size: 'default', rounded: 'lg' })}>
          Go home
        </a>
        <button
          id="go-back"
          data-card
          class={buttonVariants({ variant: 'glass', size: 'default', rounded: 'lg' })}
        >
          Go back
        </button>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.getElementById('go-back')?.addEventListener('click', () => history.back())
</script>
