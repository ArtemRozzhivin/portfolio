---
import type { ExperienceEntry } from '@services/portfolio'
import BriefcaseIcon from '@components/ui/icons/BriefcaseIcon.astro'

import ExperienceCard from './ExperienceCard.astro'

interface Props {
  experience: ExperienceEntry[]
}

const { experience } = Astro.props
---

<section id="experience" data-spy="experience" class="py-20">
  <div data-reveal class="mb-12">
    <p class="text-accent mb-2.5 font-mono text-[13px] font-semibold tracking-[0.06em]">
      04 / JOURNEY
    </p>
    <h2 class="font-display text-ink text-[clamp(34px,4.6vw,56px)] font-bold tracking-[-0.025em]">
      Experience
    </h2>
  </div>

  <div class="relative">
    <div
      data-tl-spine
      aria-hidden="true"
      class="absolute top-[6px] bottom-[6px] left-1/2 w-0.5 -translate-x-1/2 bg-[linear-gradient(var(--accent),var(--line))]"
    >
    </div>

    {
      experience.map((job, i) => (
        <div
          data-tl-row
          class:list={[
            'relative grid grid-cols-2 items-center',
            i < experience.length - 1 && 'mb-11',
          ]}
        >
          {i % 2 === 0 ? (
            <Fragment>
              <div class="pr-12">
                <ExperienceCard job={job} />
              </div>
              <div data-tl-date class="pl-12">
                <p class="text-ink mb-1 font-mono text-[15px] font-semibold">{job.period}</p>
                <p class="text-faint text-[13.5px]">{job.note}</p>
              </div>
            </Fragment>
          ) : (
            <Fragment>
              <div data-tl-date class="pr-12 text-right">
                <p class="text-ink mb-1 font-mono text-[15px] font-semibold">{job.period}</p>
                <p class="text-faint text-[13.5px]">{job.note}</p>
              </div>
              <div class="pl-12">
                <ExperienceCard job={job} />
              </div>
            </Fragment>
          )}

          <div
            data-tl-node
            aria-hidden="true"
            class:list={[
              'absolute top-1/2 left-1/2 z-2 grid size-[46px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-4 border-(--page-base)',
              job.current
                ? 'bg-accent text-accent-contrast shadow-(--card-shadow)'
                : 'glass-2 text-accent',
            ]}
          >
            <BriefcaseIcon class="size-[19px]" />
          </div>
        </div>
      ))
    }
  </div>
</section>
