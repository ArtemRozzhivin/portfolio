---
import { getAllTechs, type Project } from '@services/portfolio'
import { ProjectsExplorer } from '@components/islands/projects-explorer'
import ExternalLinkIcon from '@components/ui/icons/ExternalLinkIcon.astro'
import GithubIcon from '@components/ui/icons/GithubIcon.astro'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
const [feature, ...stacked] = projects
const allTechs = getAllTechs(projects)
---

<section id="projects" data-spy="projects" class="py-20">
  <div data-reveal class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-accent mb-2.5 font-mono text-[13px] font-semibold tracking-[0.06em]">
        02 / WORK
      </p>
      <h2 class="font-display text-ink text-[clamp(34px,4.6vw,56px)] font-bold tracking-[-0.025em]">
        Featured projects
      </h2>
    </div>
    <ProjectsExplorer client:visible projects={projects} allTechs={allTechs} />
  </div>

  <div data-bento class="grid auto-rows-fr grid-cols-12 gap-[18px]">
    <article
      data-reveal
      data-card
      class="glass col-span-7 row-span-2 flex flex-col overflow-hidden rounded-(--card-radius-lg)"
    >
      <div class="h-[300px] shrink-0 overflow-hidden">
        <img src={feature.image} alt={feature.name} class="h-full w-full object-cover object-top" />
      </div>
      <div class="flex flex-1 flex-col px-7 pt-[26px] pb-7">
        <div class="mb-3 flex items-start justify-between gap-3.5">
          <h3 class="font-display text-ink text-[25px] font-bold tracking-[-0.01em]">
            {feature.name}
          </h3>
          <div class="flex shrink-0 gap-2">
            <a
              href={feature.links.github}
              target="_blank"
              rel="noopener"
              aria-label={`${feature.name} GitHub repository`}
              class="bg-tag-bg text-ink border-tag-border grid size-[38px] place-items-center rounded-[11px] border"
            >
              <GithubIcon class="size-[17px]" />
            </a>
            <a
              href={feature.links.preview}
              target="_blank"
              rel="noopener"
              aria-label={`${feature.name} live demo`}
              class="bg-accent text-accent-contrast grid size-[38px] place-items-center rounded-[11px]"
            >
              <ExternalLinkIcon class="size-4" />
            </a>
          </div>
        </div>
        <p class="text-dim mb-[18px] flex-1 text-[15px] leading-[1.6]">{feature.description}</p>
        <div class="flex flex-wrap gap-[7px]">
          {
            feature.stack.map((tech) => (
              <span class="bg-tag-bg text-tag-text border-tag-border rounded-full border px-[11px] py-[5px] font-mono text-[11px] font-medium tracking-[0.03em]">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </article>

    {
      stacked.map((project) => (
        <article
          data-reveal
          data-delay="80"
          data-card
          class="glass col-span-5 flex flex-col overflow-hidden rounded-(--card-radius-lg)"
        >
          <div class="h-[150px] shrink-0 overflow-hidden">
            <img
              src={project.image}
              alt={project.name}
              class="h-full w-full object-cover object-top"
            />
          </div>
          <div class="flex flex-1 flex-col px-[22px] py-5">
            <div class="mb-2 flex items-center justify-between gap-2.5">
              <h3 class="font-display text-ink text-[20px] font-bold">{project.name}</h3>
              <div class="flex shrink-0 gap-[7px]">
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${project.name} GitHub repository`}
                  class="bg-tag-bg text-ink border-tag-border grid size-8 place-items-center rounded-[9px] border"
                >
                  <GithubIcon class="size-[15px]" />
                </a>
                <a
                  href={project.links.preview}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${project.name} live demo`}
                  class="bg-accent text-accent-contrast grid size-8 place-items-center rounded-[9px]"
                >
                  <ExternalLinkIcon class="size-3.5" />
                </a>
              </div>
            </div>
            <p class="text-dim mb-3.5 line-clamp-2 flex-1 text-[13.5px] leading-[1.55]">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="bg-tag-bg text-tag-text border-tag-border rounded-full border px-[9px] py-1 font-mono text-[10.5px] font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
