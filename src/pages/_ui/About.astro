---
import type { Profile } from '@services/portfolio'

interface Props {
  profile: Profile
}

const { profile } = Astro.props
---

<section id="about" data-spy="about" class="py-20">
  <div data-reveal class="mb-10">
    <p class="text-accent mb-2.5 font-mono text-[13px] font-semibold tracking-[0.06em]">
      01 / ABOUT
    </p>
    <h2 class="font-display text-ink text-[clamp(34px,4.6vw,56px)] font-bold tracking-[-0.025em]">
      A bit about me
    </h2>
  </div>

  <div data-2col class="grid grid-cols-[1.55fr_1fr] items-start gap-6">
    <div
      data-reveal
      data-card
      class="glass rounded-(--card-radius-lg) px-5 py-7 sm:px-9 sm:py-[34px]"
    >
      {
        profile.bio.map((paragraph, i) => (
          <p
            class:list={[
              'text-dim text-[16.5px] leading-[1.68]',
              i < profile.bio.length - 1 && 'mb-[18px]',
            ]}
          >
            {paragraph}
          </p>
        ))
      }
    </div>

    <div data-reveal data-delay="90" class="flex flex-col gap-3.5">
      {
        profile.facts.map((fact) => (
          <div data-card class="glass rounded-(--card-radius) px-[22px] py-5">
            <p class="text-faint mb-1.5 font-mono text-[11px] tracking-[0.06em]">{fact.label}</p>
            <p class="text-ink text-[16px] font-semibold">{fact.value}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
