---
import type { ExperienceEntry } from '@services/portfolio'

interface Props {
  job: ExperienceEntry
}

const { job } = Astro.props
---

<div data-reveal data-card class="glass rounded-(--card-radius-lg) px-7 py-[26px]">
  <h3 class="font-display text-ink mb-[3px] text-[21px] font-bold">{job.role}</h3>
  <p class="text-accent mb-4 font-mono text-[12.5px] font-semibold">{job.company} · {job.meta}</p>
  <ul class="flex flex-col gap-[9px]">
    {
      job.bullets.map((bullet) => (
        <li class="text-dim flex gap-[9px] text-[14.5px] leading-[1.5]">
          <span class="text-accent mt-px shrink-0">▹</span>
          {bullet}
        </li>
      ))
    }
  </ul>
</div>
